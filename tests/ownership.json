    },
    "Kumwe\\Transaction\\Contract\\TransactionState": {
      "behavior": [
        "Case\\TransactionStateContractTest::testThePortIsAnInterfaceWithOneBooleanQuery",
        "Case\\TransactionStateContractTest::testThePromiseCoversEveryNestingLevelAndEveryRoute"
      ],
      "boundary": [
        "Case\\TransactionStateContractTest::testThePromiseCoversEveryNestingLevelAndEveryRoute"
      ],
      "note": "Owns port signature/consumer contract; concrete adapters own their implementation behavior."
    },
    "Kumwe\\Transaction\\Testing\\ImmediateTransactionManager": {
      "behavior": [
        "Case\\ImmediateTransactionManagerTest::testItIsTheFinalReadonlyStatelessDoubleOfThePort",
        "Case\\ImmediateTransactionManagerTest::testTheOperationResultIsReturnedUnchanged"
      ],
      "boundary": [
        "Case\\ImmediateTransactionManagerTest::testAFailureReachesTheCallerAsTheSameInstance",
        "Case\\ImmediateTransactionManagerTest::testACommitHookRegisteredBeforeAFailureHasAlreadyRun"
      ]
    }
  },
  "conformance": {
    "status": "not-applicable",
    "rationale": "Ports and the immediate test double own contract cases; no algorithmic corpus applies.",
    "tests": [],
    "corpora": []
  },
  "architecture": [
    "tools/verify-architecture.php",
    "tools/verify-boundary-tokens.php"
  ],
  "host": {
    "repository": "kumwe/app",
    "baseline": "960ce8ec00cf724a7cae03e5ba09c4852c9ab54e",
    "transfers": [
      {
        "source_test": "tests/Architecture/TransactionSeamBoundaryTest.php",
        "action": "split-on-adoption",
        "package_tests": [
          "Case\\ImmediateTransactionManagerTest::testItIsTheFinalReadonlyStatelessDoubleOfThePort",
          "Case\\ImmediateTransactionManagerTest::testTheOperationResultIsReturnedUnchanged",
          "Case\\ImmediateTransactionManagerTest::testAFailureReachesTheCallerAsTheSameInstance",
          "Case\\ImmediateTransactionManagerTest::testACommitHookRunsAtOnceInsideAndOutsideAScope",
          "Case\\ImmediateTransactionManagerTest::testARollbackHookIsAlwaysDiscarded",
          "Case\\ImmediateTransactionManagerTest::testNestedCallsRunInlineAndReturnTheirOwnValues",
          "Case\\ImmediateTransactionManagerTest::testACommitHookRegisteredBeforeAFailureHasAlreadyRun"
        ],
        "retained": "Keep App adapter/composition checks and database transaction behavior."
      }
    ],
    "retained_responsibilities": [
      "Doctrine transactions, nesting/retry/deadlock policy, database matrix, outbox/audit and application composition."
    ]
