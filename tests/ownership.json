      "boundary": [
        "Case\\ImmediateTransactionManagerTest::testAFailureReachesTheCallerAsTheSameInstance",
        "Case\\ImmediateTransactionManagerTest::testACommitHookRegisteredBeforeAFailureHasAlreadyRun"
